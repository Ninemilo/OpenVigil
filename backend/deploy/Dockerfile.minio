# The upstream image registries no longer serve the frozen test dependencies.
# Build the same releases from official, commit- and checksum-pinned source.
FROM golang:1.24.5-alpine@sha256:daae04ebad0c21149979cd8e9db38f565ecefd8547cf4a591240dc1972cf1399 AS minio-build
WORKDIR /src
ADD --checksum=sha256:f31b6997fdb098479ddddfca1267f02518ee0b59cc1d3f9682c3a48e6309f4d0 https://codeload.github.com/minio/minio/tar.gz/7ced9663e6a791fef9dc6be798ff24cda9c730ac /tmp/source.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 && rm /tmp/source.tar.gz
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2 go build -mod=readonly -trimpath -buildvcs=false -o /out/minio .

FROM golang:1.24.5-alpine@sha256:daae04ebad0c21149979cd8e9db38f565ecefd8547cf4a591240dc1972cf1399 AS mc-build
WORKDIR /src
ADD --checksum=sha256:343693800a3edc7a311e813319df36e8f486c1c470aa8d4edf98987fd9ea06e5 https://codeload.github.com/minio/mc/tar.gz/ee72571936f15b0e65dc8b4a231a4dd445e5ccb6 /tmp/source.tar.gz
RUN tar -xzf /tmp/source.tar.gz --strip-components=1 && rm /tmp/source.tar.gz
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 GOTOOLCHAIN=local GOMAXPROCS=2 go build -mod=readonly -trimpath -buildvcs=false -o /out/mc .

FROM alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1 AS minio
COPY --from=minio-build /out/minio /usr/local/bin/minio
COPY --from=minio-build /src/LICENSE /licenses/minio/LICENSE
COPY --from=minio-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="7ced9663e6a791fef9dc6be798ff24cda9c730ac" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
RUN mkdir -p /data /home/minio && chown -R 10001:10001 /data /home/minio
ENV HOME=/home/minio
USER 10001:10001
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]

FROM alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1 AS mc
COPY --from=mc-build /out/mc /usr/local/bin/mc
COPY --from=mc-build /src/LICENSE /licenses/mc/LICENSE
COPY --from=mc-build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
LABEL org.opencontainers.image.source="https://github.com/minio/mc" \
      org.opencontainers.image.revision="ee72571936f15b0e65dc8b4a231a4dd445e5ccb6" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
RUN mkdir -p /home/minio && chown 10001:10001 /home/minio
ENV HOME=/home/minio
USER 10001:10001
ENTRYPOINT ["mc"]
